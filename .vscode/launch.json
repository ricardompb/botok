  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "BOTOK FRONT",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["run", "serve"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "BOTOK BACK DEBUG",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["run", "start:debug"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "BOTOK",
      "configurations": ["BOTOK FRONT", "BOTOK BACK DEBUG"]
    }
  ]
}
